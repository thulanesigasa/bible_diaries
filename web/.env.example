# waitlist: existing public signup site; admin: central two-workspace administrator portal.
# combined preserves the earlier single-host layout while migrating an existing deployment.
SITE_ROLE=waitlist
MAIN_SITE_URL=https://biblediaries.co.za
WAITLIST_URL=https://waiting.biblediaries.co.za
# Public website origin. Use the exact HTTPS domain after deployment.
SITE_URL=http://localhost:3000
# Optional: official, deployed signed-in browser app URL. Leave empty until available.
APP_WEB_URL=
# Server-only credentials for Bible Diaries, never NEXT_PUBLIC_.
SUPABASE_URL=https://fspfwidfdnqvpgmipate.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random characters. Keep stable so rate limits cannot be reset by visitors.
WAITLIST_RATE_LIMIT_SALT=
# A single-IP header OVERWRITTEN by your hosting ingress. Vercel: x-vercel-forwarded-for.
# Cloudflare: cf-connecting-ip. Do not trust a client-supplied x-forwarded-for.
WAITLIST_TRUSTED_IP_HEADER=
# Admin uses verified Supabase Auth accounts. Comma-separated approved account UUIDs.
ADMIN_USER_IDS=
# Server-only publishable (or legacy anon) key for the SAME Bible Diaries project.
SUPABASE_PUBLISHABLE_KEY=
# Separate random salt, at least 32 characters, for login abuse protection.
ADMIN_RATE_LIMIT_SALT=

# Main-domain moderator login abuse protection (at least 32 random characters).
MODERATION_RATE_LIMIT_SALT=

ADMIN_SITE_URL=https://admin.biblediaries.co.za

# Optional transaction receipts. Enable only after the sender DNS is verified.
WAITLIST_CONFIRMATION_EMAILS=false
RESEND_API_KEY=
WAITLIST_MAIL_FROM=updates@news.biblediaries.co.za
WAITLIST_MAIL_REPLY_TO=support@biblediaries.co.za
# Reserve allowance for Auth emails on the same Resend account; this is not a provider-wide quota tracker.
WAITLIST_MAIL_DAILY_LIMIT=40
# A separate 32+ character bearer secret for scheduled POST /api/internal/waitlist-mail.
WAITLIST_MAIL_CRON_SECRET=
